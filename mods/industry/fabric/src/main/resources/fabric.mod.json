{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/JordanOlivet/krios",
        "sources": "https://github.com/JordanOlivet/krios",
        "issues": "https://github.com/JordanOlivet/krios/issues"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "io.lakio.krios.industry.KriosIndustry"
        ],
        "client": [
            "io.lakio.krios.industry.client.KriosIndustryClient"
        ],
        "jei_mod_plugin": [
            "io.lakio.krios.industry.integration.jei.KriosIndustryJeiPlugin"
        ],
        "emi": [
            "io.lakio.krios.industry.integration.emi.KriosIndustryEmiPlugin"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "krios_core": ">=${krios_core_version}",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    },
    "custom": {
        "mc-publish": {
            "dependencies": [
                "krios_core@>=${krios_core_version}(required){modrinth:krios-core}{curseforge:krios-core}"
            ]
        }
    }
}
  