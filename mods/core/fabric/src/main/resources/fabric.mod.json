{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/JordanOlivet/krios",
        "sources": "https://github.com/JordanOlivet/krios",
        "issues": "https://github.com/JordanOlivet/krios/issues"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "io.lakio.krios.core.KriosCore"
        ],
        "client": [
            "io.lakio.krios.core.client.KriosCoreClient"
        ],
        "jei_mod_plugin": [
            "io.lakio.krios.core.integration.jei.KriosCoreJeiPlugin"
        ],
        "emi": [
            "io.lakio.krios.core.integration.emi.KriosCoreEmiPlugin"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
